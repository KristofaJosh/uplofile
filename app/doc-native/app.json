{
  "expo": {
    "name": "Uplofile Native",
    "slug": "doc-native",
    "version": "0.1.0",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "com.uplofile.native"
    },
    "android": {
      "package": "com.uplofile.native"
    },
    "plugins": [
      "expo-status-bar",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Uplofile Native to access your photos to test the pickFiles adapters."
        }
      ]
    ]
  }
}
